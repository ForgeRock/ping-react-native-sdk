<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Domain resolved from ASSOCIATED_DOMAIN in Config.local.xcconfig. It must match the Apple Developer associated domains (webcredentials) configured for the App ID. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:$(ASSOCIATED_DOMAIN)</string>
	</array>
</dict>
</plist>
